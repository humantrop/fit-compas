# =============================================================================
# Fit Compas — environment variables
#
# Copy to .env.local for local development, and add the same values to the
# Vercel project (Settings -> Environment Variables) for the live site.
# Never commit .env.local — .gitignore already covers it.
# =============================================================================

# ---------- Supabase --------------------------------------------------------
# Supabase Studio -> Project Settings -> API Keys

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "publishable" (formerly "anon") key. Safe to expose to the browser —
# it only ever grants what RLS policies allow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The "secret" (formerly "service_role") key. BYPASSES RLS ENTIRELY.
# Server-side only. Never prefix it with NEXT_PUBLIC_, never log it,
# never paste it anywhere the browser can reach.
SUPABASE_SECRET_KEY=

# ---------- Postgres --------------------------------------------------------
# Supabase Studio -> Project Settings -> Database -> Connection string
# Copy both, and replace [YOUR-PASSWORD] with the database password.
#
# Two different strings on purpose:
#
# DATABASE_URL  - Transaction pooler, port 6543. Used by the app at runtime.
#                 Serverless functions open a connection per invocation, and
#                 the direct Postgres connection limit is low enough that a
#                 traffic spike exhausts it. The pooler is what survives that.
#                 postgres.js must run with prepare:false against it, because
#                 transaction pooling cannot hold prepared statements.
#
# DIRECT_URL    - Session pooler, port 5432. Used by drizzle-kit for
#                 migrations only. DDL needs a real session, which the
#                 transaction pooler does not give you.
#
# Also: the direct db.<ref>.supabase.co host is IPv6-only on new projects, so
# it fails from Vercel and from most home connections. Use the pooler hosts.
DATABASE_URL=
DIRECT_URL=

# ---------- Site ------------------------------------------------------------
# Absolute origin used to build links that leave the app and come back:
# Supabase confirmation emails and Polar checkout returns.
# Leave empty locally — it falls back to the request host.
NEXT_PUBLIC_SITE_URL=https://fit-compas.vercel.app

# ---------- Polar.sh (needed from step 9, not before) -----------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# "sandbox" while testing, "production" once the flow works end to end.
POLAR_SERVER=sandbox

# ---------- Notifications (feature 15) --------------------------------------
# Shared secret for the cron job that fires scheduled notifications. Vercel
# sends it as `Authorization: Bearer $CRON_SECRET` to the path in vercel.json.
# Until it is set, /api/notifications/dispatch refuses everyone but a signed-in
# admin — a dispatcher anybody can trigger is a way to burn someone else's mail
# quota. Any long random string; `openssl rand -hex 32` will do.
CRON_SECRET=

# Resend API key. Without it notifications still arrive in the app, and the
# admin screen says email is not configured rather than queueing mail nothing
# will send. Feature 17 turns this on properly and points the Supabase auth
# mailer at the same account.
RESEND_API_KEY=

# Sender for notification mail. Resend's shared onboarding@resend.dev works
# without a verified domain but only delivers to the account owner's own
# address — fine for checking the wiring, useless for clients.
NOTIFICATIONS_FROM_EMAIL=
